# Production must use a Vibehost persistent directory; never /tmp or public/.
DATABASE_PATH=/data/cvmais.sqlite
APP_ORIGIN=https://cvmais.co.mz
# Transitional exact origin for existing sessions and local drafts, no wildcards.
APP_ALLOWED_ORIGINS=https://cvmais.win,https://cvmais-dgc.n1.tinhgon.xyz
# Off-server backup remains disabled until a restricted B2 key, encryption key,
# owner-held key recovery copy and bucket lifecycle policy have been configured.
BACKUP_ENABLED=false
B2_BUCKET_ID=30b5e9b191056cc3a8160910
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# BACKUP_ENCRYPTION_KEY=64_hex_characters_generated_privately
# Sending is opt-in after domain verification and a delivery test.
MAIL_ENABLED=false
MAIL_FROM=CVMais <nao-responder@cvmais.win>
# RESEND_API_KEY=
# Queued authentication mail uses a dedicated derived encryption key.
# By default its root is the existing BACKUP_ENCRYPTION_KEY (domain-separated HKDF).
# Without backup configuration, set a private 32-byte hexadecimal root below.
# Preserve this root across redeploys/restores; never expose it to the browser.
# AUTH_MAIL_ENCRYPTION_KEY=64_hex_characters_generated_privately

# Restrict operations details to this verified account email.
OPERATIONS_EMAIL=nguyenhai1080@gmail.com
# Owner-approved incident/recovery messages, no CV contents.
BACKUP_ALERTS_ENABLED=false

# Optional and consent-gated GA4 reporting; leave unset to disable analytics.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
